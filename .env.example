# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Required ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model selection ---
# Any current Gemini model works. Flash-tier models are cheap and have huge
# (~1M token) context windows, which is why chunking is a "quality" choice
# for this project more than a hard necessity for most single videos.
# Good options as of mid-2026: gemini-2.5-flash (stable/cheap default),
# gemini-3.5-flash or gemini-3.6-flash (newer, stronger, pricier).
GEMINI_MODEL=gemini-2.5-flash

# --- Chunking tuning (Phase 3) ---
# Rough token budget we allow per chunk before we start splitting the
# transcript. Kept well below the model's real context window on purpose,
# because per-chunk summaries are higher quality when the chunk is focused
# rather than maxed out.
CHUNK_TARGET_TOKENS=3000
# If two transcript segments are separated by a silence/gap longer than this
# many seconds, treat it as a likely topic boundary when chunking.
CHUNK_GAP_SECONDS=2.5

# --- Limits / safety valves ---
# Refuse videos longer than this (in seconds) to keep costs/runtime sane.
# 4 hours by default.
MAX_VIDEO_DURATION_SECONDS=14400

# --- Whisper fallback (Phase 1) ---
# Only used when a video has no captions at all.
WHISPER_MODEL_SIZE=base
# cpu or cuda
WHISPER_DEVICE=cpu

# --- Storage ---
OUTPUT_DIR=outputs
JOBS_DIR=jobs_store
